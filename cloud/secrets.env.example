# AeroPatch bulut anahtarlari — SABLON (gercek anahtar YOK)
# Bu dosyayi "cloud/secrets.env" olarak kopyalayip anahtarlari girin.
# cloud/secrets.env .gitignore'dadir — ASLA commit edilmez.
# Eski secrets.env silindi (anahtarlar sizekalmasin); NIM icin yeni anahtar
# uretip asagidaki alana girin, sunucu tarafindan otomatik yuklenir.

# NVIDIA NIM inference anahtari (https://integrate.api.nvidia.com)
NEBIUS_API_KEY=

# NVIDIA NIM base URL
NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1

# Model: super-120b 8/8 OK (en hizli); lightning thinking uretimi 25 sn'yi asiyordu
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Tavily canli hava anahtari (bos birakilirsa handler ucretsiz DDGS'ye duser)
TAVILY_API_KEY=

# Bulut sunucu portu (cloud/local_cloud_server.py)
CLOUD_PORT=8091