<?xml version="1.0" ?>
<!-- AeroPatch Gazebo Classic dunyasi:
     - 8x8 m arena (duvarlar robotu goruntu alaniinda tutar)
     - kuru zemin (mu=1.0) -> 'yagmur' kaymasi gz_disturbance_node ile uygulanir
     - gazebo_ros_state plugin'i: /gazebo/get_entity_state + /gazebo/set_entity_state
       (harici lokalizasyon gercegi + fiziksel kayma enjeksiyonu icin) -->
<sdf version="1.6">
  <world name="aero_world">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.42 0.46 0.52 1</ambient>
            <diffuse>0.52 0.56 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Arena duvarlari: YENI elips (cx=2.2 cy=0.0 rx=2.2 ry=1.5) cevresinde.
         Eski duvarlar (y=-0.75 / x=4.0) yeni elipsin ICINDE kaliyordu ->
         robot duvara carip duruyordu. Yeni guvenli sinir:
         x [-0.3, 4.7]  y [-1.75, 1.75] -->
    <model name="wall_south">
      <static>true</static>
      <pose>2.2 -1.75 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>7.0 0.15 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7.0 0.15 0.4</size></box></geometry>
          <material><ambient>0.75 0.7 0.65 1</ambient><diffuse>0.8 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static>
      <pose>2.2 1.75 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>7.0 0.15 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7.0 0.15 0.4</size></box></geometry>
          <material><ambient>0.75 0.7 0.65 1</ambient><diffuse>0.8 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-0.3 0.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 4.0 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 4.0 0.4</size></box></geometry>
          <material><ambient>0.75 0.7 0.65 1</ambient><diffuse>0.8 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>4.7 0.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 4.0 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 4.0 0.4</size></box></geometry>
          <material><ambient>0.75 0.7 0.65 1</ambient><diffuse>0.8 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
