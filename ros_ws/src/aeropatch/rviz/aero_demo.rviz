Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Value: true
      Color: 160; 160; 164
      Cell Size: 1
      Plane Cell Count: 12
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Value: true
      Frame Timeout: 15
      Show Arrows: false
      Show Axes: false
      Show Names: false
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: ReferencePath
      Value: true
      Topic:
        Value: /reference_path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 25; 255; 0
      Alpha: 0.7
      Buffer Length: 1
      Line Width: 0.07
      Style: Billboards
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: TruthPath
      Value: true
      Topic:
        Value: /truth_path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 40; 40
      Alpha: 1
      Buffer Length: 1
      Line Width: 0.04
      Style: Lines
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: OdomPathLiar
      Value: true
      Topic:
        Value: /odom_path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 0; 120; 255
      Alpha: 1
      Buffer Length: 1
      Line Width: 0.06
      Style: Lines
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: TruthPose
      Value: true
      Topic:
        Value: /ground_truth
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 40; 40
      Alpha: 1
      Shape: Arrow
      Axes Length: 0.5
      Axes Radius: 0.05
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: SlipMarkers
      Value: true
      Topic:
        Value: /slip_markers
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
    Use Sim Time: true
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Enable Stereo Rendering: false
      Focal Point:
        X: 2.2
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: <Fixed Frame>
      Yaw: 4.712
Window Geometry:
  Height: 800
  Width: 1000
