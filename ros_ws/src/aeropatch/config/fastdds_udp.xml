<?xml version="1.0" encoding="UTF-8" ?>
<!-- FastDDS profili: SHM kapali. WSL2'de /dev/shm fastrtps_port kilit
     cakismasi ("open_and_lock_file failed") servis kesfini bozuyor ->
     spawn_entity 30s timeout'unun kok nedeni. Sadece UDPv4 kullan. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="aero_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_only</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
